# Copie para .env e ajuste. Valores abaixo são só para desenvolvimento local.
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug
CORS_ORIGINS=http://localhost:4200,http://localhost:4300

# A API usa app_runtime. As migrations usam app_migrator (ver npm run migration:*).
DATABASE_URL=postgres://app_runtime:dev_runtime_pw@localhost:5432/canal_denuncias
DATABASE_MIGRATOR_URL=postgres://app_migrator:dev_migrator_pw@localhost:5432/canal_denuncias
DATABASE_SSL=false

# --- Usados pelos próximos módulos (ainda não validados no env.schema.ts) ---
REDIS_URL=redis://localhost:6379
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=dev-root-token
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_BUCKET=attachments
S3_ACCESS_KEY=dev-access-key
S3_SECRET_KEY=dev-secret-key
SMTP_HOST=localhost
SMTP_PORT=1025
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
VAULT_TIMEOUT_MS=2000
# Produção usa AppRole (VAULT_TOKEN é recusado com NODE_ENV=production). Em dev, o vault-init cria estes IDs fixos.
VAULT_ROLE_ID=dev-api-role-id
VAULT_SECRET_ID=dev-api-secret-id
S3_FORCE_PATH_STYLE=true
SMTP_FROM=canal-denuncias@localhost
SESSION_SECRET=dev-session-secret-com-pelo-menos-32-bytes
REPORTER_TOKEN_SECRET=dev-reporter-token-secret-com-32-bytes-ou-mais
# Custo do hash scrypt (logN). Abaixo de 17 só é aceito com NODE_ENV=test.
PASSWORD_HASH_LOG_N=17
MAX_ATTACHMENT_BYTES=10485760

# Só testes de integração: superusuário que cria e descarta os bancos de cada suíte.
TEST_ADMIN_DATABASE_URL=postgres://postgres:dev_superuser_pw@localhost:5432/postgres

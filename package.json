{
  "name": "canal-denuncias-api",
  "version": "0.0.1",
  "description": "API do Canal de Denúncias de Vazamento de Dados",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "node --env-file-if-exists=.env node_modules/@nestjs/cli/bin/nest.js start --watch",
    "start:debug": "node --env-file-if-exists=.env node_modules/@nestjs/cli/bin/nest.js start --debug --watch",
    "start:prod": "node dist/main.js",
    "lint": "oxlint --type-aware src/ test/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "migration:create": "typeorm migration:create",
    "migration:generate": "npm run build && node --env-file-if-exists=.env node_modules/typeorm/cli.js migration:generate -d dist/database/data-source.js",
    "migration:run": "npm run build && node --env-file-if-exists=.env node_modules/typeorm/cli.js migration:run -d dist/database/data-source.js",
    "migration:revert": "npm run build && node --env-file-if-exists=.env node_modules/typeorm/cli.js migration:revert -d dist/database/data-source.js",
    "migration:show": "npm run build && node --env-file-if-exists=.env node_modules/typeorm/cli.js migration:show -d dist/database/data-source.js",
    "prepare": "husky",
    "openapi:export": "npm run build && node dist/scripts/export-openapi.js",
    "cli": "node --env-file-if-exists=.env dist/cli.js",
    "test:cov:all": "vitest run --config ./vitest.config.coverage.ts --coverage"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1179.0",
    "@aws-sdk/lib-storage": "^3.1179.0",
    "@nestjs/authentication": "0.1.8",
    "@nestjs/authorization": "0.1.4",
    "@nestjs/bullmq": "^12.0.2",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/swagger": "^12.1.3",
    "@nestjs/terminus": "^12.2.0",
    "@nestjs/typeorm": "^12.0.3",
    "bullmq": "^6.7.10",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "nest-commander": "^3.21.0",
    "nestjs-pino": "^5.3.2",
    "pg": "^8.23.1",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^1.1.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^5.1.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.2",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^4.1.2"
  },
  "engines": {
    "node": ">=26"
  },
  "lint-staged": {
    "*.ts": [
      "prettier --write",
      "oxlint --type-aware"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
